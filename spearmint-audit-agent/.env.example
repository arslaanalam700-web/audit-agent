# Copy this file to audit-agent/.env and fill in the values you have.
# The engine runs without any of the optional keys. Those checks report "not configured".

AUDIT_MCP_TOKEN=change-me
AUDIT_HOST=127.0.0.1
AUDIT_PORT=8800
AUDIT_DB=data/audits.db

# Optional. Without this, PageSpeed uses the shared free quota and often returns 429.
PAGESPEED_API_KEY=

# Optional. Used only when someone passes --ai. The report template works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional off-page data (DataForSEO). Leave blank to skip that agent.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional. Only for clients who have granted access.
SEARCH_CONSOLE_ACCESS_TOKEN=
GA4_ACCESS_TOKEN=

# WordPress apply. The agent still cannot run until someone approves the audit id.
WP_USER=
WP_APP_PASSWORD=

# Webhook shared secret for the lead-auditor route.
WEBHOOK_SECRET=change-me
AUDIT_DOMAIN=audit.example.com
