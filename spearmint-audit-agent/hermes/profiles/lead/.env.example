A2A_PORT=9900
A2A_AGENT_NAME=spearmint-lead
A2A_HOST=127.0.0.1
A2A_REPLY_TIMEOUT=1800
A2A_MAX_PINGPONG_TURNS=5
# Inbound token. Callers send this same value as A2A_TOKEN_LEAD.
A2A_BEARER_TOKEN=replace-with-token-for-lead
AUDIT_MCP_TOKEN=replace-with-the-engine-token
OPENROUTER_API_KEY=
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8644
WEBHOOK_SECRET=replace-with-the-webhook-secret
A2A_PUBLIC_URL=
A2A_TOKEN_TECHNICAL=replace-with-token-for-technical
A2A_TOKEN_CONTENT=replace-with-token-for-content
A2A_TOKEN_PERFORMANCE=replace-with-token-for-performance
A2A_TOKEN_UX=replace-with-token-for-ux
A2A_TOKEN_SECURITY=replace-with-token-for-security
A2A_TOKEN_OFFPAGE=replace-with-token-for-offpage
A2A_TOKEN_QA=replace-with-token-for-qa
A2A_TOKEN_FIXER=replace-with-token-for-fixer
A2A_TOKEN_WPFIXER=replace-with-token-for-wpfixer
