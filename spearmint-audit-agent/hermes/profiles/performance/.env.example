A2A_PORT=9903
A2A_AGENT_NAME=spearmint-performance
A2A_HOST=127.0.0.1
A2A_REPLY_TIMEOUT=1800
A2A_MAX_PINGPONG_TURNS=5
# Inbound token. Callers send this same value as A2A_TOKEN_PERFORMANCE.
A2A_BEARER_TOKEN=replace-with-token-for-performance
AUDIT_MCP_TOKEN=replace-with-the-engine-token
OPENROUTER_API_KEY=
